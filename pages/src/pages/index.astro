---
import { Clipboard, Eye, RefreshCw, Server } from '@lucide/astro';
import '../styles/global.css';

const placeholders = ['edition', 'motd', 'protocol', 'version', 'players', 'maxPlayers', 'serverId', 'subMotd', 'gamemode', 'gamemodeId', 'portIpv4', 'portIpv6'];
---

<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="https://static.cosmicpe.me/logo.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Build Shields.io badges for Minecraft Bedrock servers." />
    <title>mcpe-shield Badge Builder</title>
    <style>
      .preview-box.loading img {
        opacity: 0;
      }

      .preview-box.loading [data-preview-status],
      .preview-box.error [data-preview-status] {
        display: block;
      }
    </style>
  </head>
  <body class="min-h-screen bg-base-200 text-base-content">
    <main class="mx-auto grid min-h-screen w-[min(1200px,calc(100%-2rem))] grid-cols-1 gap-4 py-4 lg:grid-cols-[minmax(0,1fr)_minmax(360px,430px)]">
      <section class="flex min-w-0 flex-col gap-4">
        <header class="flex items-center justify-between gap-4 border-b border-base-300 pb-4 max-sm:flex-col max-sm:items-start">
          <div class="flex min-w-0 items-center gap-4">
            <img src="https://static.cosmicpe.me/logo.svg" alt="CosmicPE" width="36" height="36" />
            <div class="min-w-0">
              <h1 class="text-2xl font-black leading-tight">mcpe-shield</h1>
              <p class="text-base text-base-content/65">Build shields.io badges for Minecraft Bedrock servers.</p>
            </div>
          </div>
          <a class="btn btn-outline" href="https://github.com/Cosmoverse/mcpe-shield">
            GitHub
          </a>
        </header>

        <form class="grid gap-4" data-builder>
          <div class="card border border-base-300 bg-base-100 shadow-sm">
            <div class="card-body grid grid-cols-1 gap-4 p-4 sm:grid-cols-2">
              <label class="form-control gap-1.5">
                <span class="label p-0 text-sm font-extrabold"><Server size={15} /> Server host</span>
                <input class="input input-bordered w-full" name="host" value="cannon.cosmicpe.me" placeholder="play.example.net" autocomplete="off" />
              </label>

              <label class="form-control gap-1.5">
                <span class="label p-0 text-sm font-extrabold">Port</span>
                <input class="input input-bordered w-full" name="port" value="19132" inputmode="numeric" placeholder="19132" />
              </label>

              <label class="form-control gap-1.5">
                <span class="label p-0 text-sm font-extrabold">Colour</span>
                <select class="select select-bordered w-full" name="colour">
                  <option value="">brightgreen</option>
                  <option>blue</option>
                  <option>green</option>
                  <option>yellow</option>
                  <option>orange</option>
                  <option>red</option>
                  <option>success</option>
                  <option>informational</option>
                </select>
              </label>

              <label class="form-control gap-1.5">
                <span class="label p-0 text-sm font-extrabold">Custom hex</span>
                <input class="input input-bordered w-full" name="hex" placeholder="44cc88" autocomplete="off" />
              </label>

              <label class="form-control gap-1.5">
                <span class="label p-0 text-sm font-extrabold">Label</span>
                <input class="input input-bordered w-full" name="label" value="'motd'" autocomplete="off" />
              </label>

              <label class="form-control gap-1.5">
                <span class="label p-0 text-sm font-extrabold">Message</span>
                <input class="input input-bordered w-full" name="message" value="v'version' ('players'/'maxPlayers')" autocomplete="off" />
              </label>

              <label class="form-control gap-1.5">
                <span class="label p-0 text-sm font-extrabold">Offline label</span>
                <input class="input input-bordered w-full" name="offlineLabel" value="Server" autocomplete="off" />
              </label>

              <label class="form-control gap-1.5">
                <span class="label p-0 text-sm font-extrabold">Offline message</span>
                <input class="input input-bordered w-full" name="offlineMessage" value="offline" autocomplete="off" />
              </label>
            </div>
          </div>
        </form>

        <section class="card border border-base-300 bg-base-100 shadow-sm">
          <div class="card-body gap-3 p-4">
            <div class="flex items-center justify-between gap-3">
              <h2 class="flex items-center gap-2 text-lg font-black"><Eye size={20} /> Preview</h2>
              <button class="btn btn-primary btn-square" type="button" data-preview aria-label="Refresh preview" title="Refresh preview">
                <RefreshCw size={18} />
              </button>
            </div>
            <div class="preview-box relative flex min-h-24 items-center justify-center rounded-box border border-dashed border-base-300 bg-base-200 p-4" data-preview-box>
              <img class="max-w-full" data-preview-image alt="Badge preview" />
              <span class="hidden text-sm font-bold text-base-content/65" data-preview-status>Loading preview...</span>
            </div>
            <p class="text-base leading-snug text-base-content/65">URL updates as you type. Badge image only refreshes when you click Preview, because manners.</p>
          </div>
        </section>
      </section>

      <aside class="flex min-w-0 flex-col gap-4 lg:sticky lg:top-4 lg:self-start">
        <section class="card border border-base-300 bg-base-100 shadow-sm">
          <div class="card-body gap-3 p-4">
            <h2 class="text-base font-black">Placeholders</h2>
            <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
              {placeholders.map((key) => (
                <button class="btn h-auto min-h-0 justify-start bg-base-200 px-3 py-2 text-left" type="button" data-placeholder={key}>
                  <span class="grid min-w-0 gap-1">
                    <strong class="min-w-0 break-words font-mono text-sm font-black">'{key}'</strong>
                    <span class="min-w-0 break-words text-xs font-normal leading-snug text-base-content/60" data-placeholder-value={key}>-</span>
                  </span>
                </button>
              ))}
            </div>
          </div>
        </section>

        <section class="card border border-base-300 bg-base-100 shadow-sm">
          <div class="card-body min-w-0 gap-3 p-4">
            <h2 class="text-lg font-black">Markdown & URLs</h2>
            <div class="grid min-w-0 gap-3">
              <div class="grid min-w-0 gap-1.5">
                <div class="flex min-w-0 items-center justify-between gap-2">
                  <span class="min-w-0 text-sm font-extrabold uppercase text-base-content/65">Markdown</span>
                  <button class="btn btn-neutral btn-sm" type="button" data-copy-md>
                    <Clipboard size={14} /> Copy
                  </button>
                </div>
                <output class="block min-h-12 min-w-0 max-w-full whitespace-pre-wrap break-all rounded-box border border-base-300 bg-base-200 p-3 font-mono text-sm leading-snug" data-markdown></output>
              </div>

              <div class="grid min-w-0 gap-1.5">
                <div class="flex min-w-0 items-center justify-between gap-2">
                  <span class="min-w-0 text-sm font-extrabold uppercase text-base-content/65">Shields.io URL</span>
                  <button class="btn btn-neutral btn-sm" type="button" data-copy-shields-url>
                    <Clipboard size={14} /> Copy
                  </button>
                </div>
                <output class="block min-h-12 min-w-0 max-w-full whitespace-pre-wrap break-all rounded-box border border-base-300 bg-base-200 p-3 font-mono text-sm leading-snug" data-shields-url></output>
              </div>

              <div class="grid min-w-0 gap-1.5">
                <div class="flex min-w-0 items-center justify-between gap-2">
                  <span class="min-w-0 text-sm font-extrabold uppercase text-base-content/65">Endpoint URL</span>
                  <button class="btn btn-neutral btn-sm" type="button" data-copy-raw-url>
                    <Clipboard size={14} /> Copy
                  </button>
                </div>
                <output class="block min-h-12 min-w-0 max-w-full whitespace-pre-wrap break-all rounded-box border border-base-300 bg-base-200 p-3 font-mono text-sm leading-snug" data-raw-url></output>
              </div>
            </div>
          </div>
        </section>
      </aside>
    </main>

    <div class="toast toast-end hidden" data-toast>
      <div class="alert alert-neutral py-2 text-sm font-bold">Copied.</div>
    </div>

    <script>
      const form = document.querySelector('[data-builder]') as HTMLFormElement;
      const markdownOutput = document.querySelector('[data-markdown]') as HTMLOutputElement;
      const shieldsUrlOutput = document.querySelector('[data-shields-url]') as HTMLOutputElement;
      const rawUrlOutput = document.querySelector('[data-raw-url]') as HTMLOutputElement;
      const previewBox = document.querySelector('[data-preview-box]') as HTMLDivElement;
      const previewStatus = document.querySelector('[data-preview-status]') as HTMLSpanElement;
      const previewImage = document.querySelector('[data-preview-image]') as HTMLImageElement;
      const previewButton = document.querySelector('[data-preview]') as HTMLButtonElement;
      const copyMarkdownButton = document.querySelector('[data-copy-md]') as HTMLButtonElement;
      const copyShieldsUrlButton = document.querySelector('[data-copy-shields-url]') as HTMLButtonElement;
      const copyRawUrlButton = document.querySelector('[data-copy-raw-url]') as HTMLButtonElement;
      const placeholderButtons = document.querySelectorAll('[data-placeholder]') as NodeListOf<HTMLButtonElement>;
      const placeholderValues = document.querySelectorAll('[data-placeholder-value]') as NodeListOf<HTMLSpanElement>;
      const toast = document.querySelector('[data-toast]') as HTMLDivElement;

      const endpointBase = 'https://badge.cosmicpe.dev';
      const shieldsBase = 'https://img.shields.io/endpoint?url=';

      function cleanSegment(value: string) {
        return value.trim().replaceAll('-', ' ');
      }

      function encodeEndpointSegment(value: string) {
        return encodeURIComponent(cleanSegment(value));
      }

      function getBadgeUrls() {
        const data = new FormData(form);
        const host = cleanSegment(String(data.get('host') || 'play.example.net')) || 'play.example.net';
        const port = cleanSegment(String(data.get('port') || '19132')) || '19132';
        const colour = cleanSegment(String(data.get('hex') || data.get('colour') || ''));
        const target = `${host}:${port}`;
        const parts = [
          encodeEndpointSegment(target),
          encodeEndpointSegment(colour),
          encodeEndpointSegment(String(data.get('label') || '')),
          encodeEndpointSegment(String(data.get('message') || '')),
          encodeEndpointSegment(String(data.get('offlineLabel') || '')),
          encodeEndpointSegment(String(data.get('offlineMessage') || '')),
        ];
        while (parts.length > 1 && parts[parts.length - 1] === '') {
          parts.pop();
        }
        const rawUrl = `${endpointBase}/${parts.join('-')}`;
        const shieldsUrl = `${shieldsBase}${encodeURIComponent(rawUrl)}`;
        const pingUrl = `${endpointBase}/ping/${encodeURIComponent(target)}`;
        return { rawUrl, shieldsUrl, pingUrl };
      }

      function updateOutputs() {
        const { rawUrl, shieldsUrl } = getBadgeUrls();
        markdownOutput.textContent = `![Minecraft Bedrock server badge](${shieldsUrl})`;
        shieldsUrlOutput.textContent = shieldsUrl;
        rawUrlOutput.textContent = rawUrl;
      }

      function showToast() {
        toast.classList.remove('hidden');
        window.setTimeout(() => toast.classList.add('hidden'), 1800);
      }

      async function copyText(text: string) {
        await navigator.clipboard.writeText(text);
        showToast();
      }

      async function updatePlaceholderValues() {
        const response = await fetch(getBadgeUrls().pingUrl);
        if (!response.ok) return;
        const data = await response.json();
        placeholderValues.forEach((value) => {
          const key = value.dataset.placeholderValue || '';
          value.textContent = String(data[key] ?? '-');
        });
      }

      form.addEventListener('input', updateOutputs);
      previewButton.addEventListener('click', () => {
        previewBox.classList.remove('error');
        previewBox.classList.add('loading');
        previewStatus.textContent = 'Loading preview...';
        previewImage.src = getBadgeUrls().shieldsUrl;
      });
      previewImage.addEventListener('load', () => {
        previewBox.classList.remove('loading', 'error');
        updatePlaceholderValues();
      });
      previewImage.addEventListener('error', () => {
        previewBox.classList.remove('loading');
        previewBox.classList.add('error');
        previewStatus.textContent = 'Preview failed.';
      });
      copyMarkdownButton.addEventListener('click', () => copyText(markdownOutput.textContent || ''));
      copyShieldsUrlButton.addEventListener('click', () => copyText(shieldsUrlOutput.textContent || ''));
      copyRawUrlButton.addEventListener('click', () => copyText(rawUrlOutput.textContent || ''));
      placeholderButtons.forEach((button) => {
        button.addEventListener('click', () => copyText(`'${button.dataset.placeholder || ''}'`));
      });

      updateOutputs();
      previewImage.src = getBadgeUrls().shieldsUrl;
    </script>
  </body>
</html>

---
import { Badge, Clipboard, Eye, RefreshCw, Server, Sparkles } from '@lucide/astro';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="https://static.cosmicpe.me/logo.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Build Shields.io badges for Minecraft Bedrock servers." />
    <title>mcpe-shield Badge Builder</title>
    <style>
      :root {
        color-scheme: light;
        font-family:
          Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        background: #f7f7f4;
        color: #141414;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        min-height: 100vh;
        background:
          linear-gradient(135deg, rgba(45, 125, 90, 0.09), transparent 34%),
          linear-gradient(315deg, rgba(26, 86, 155, 0.08), transparent 38%),
          #f7f7f4;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      .shell {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(320px, 420px);
        gap: 24px;
        width: min(1120px, calc(100% - 32px));
        min-height: 100vh;
        margin: 0 auto;
        padding: 24px 0;
      }

      .main-column,
      .side-column,
      .builder {
        display: flex;
        min-width: 0;
        flex-direction: column;
        gap: 16px;
      }

      .side-column {
        position: sticky;
        top: 24px;
        align-self: start;
      }

      .topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        border-bottom: 1px solid #deded7;
        padding-bottom: 16px;
      }

      .brand,
      h1,
      .panel-head,
      .preview-head,
      label span {
        display: flex;
        align-items: center;
      }

      .brand {
        min-width: 0;
        gap: 12px;
      }

      h1 {
        margin: 0;
        gap: 8px;
        font-size: 1.55rem;
        line-height: 1.1;
        letter-spacing: 0;
      }

      h1 svg,
      h2 svg,
      label svg {
        color: #16805b;
        flex: none;
      }

      p {
        margin: 0;
      }

      .brand p,
      .hint {
        color: #66685f;
        font-size: 0.92rem;
      }

      .panel {
        border: 1px solid #deded7;
        border-radius: 8px;
        background: rgba(255, 255, 255, 0.92);
        box-shadow: 0 12px 32px rgba(30, 38, 32, 0.08);
        padding: 16px;
      }

      .form-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 16px;
      }

      label {
        display: grid;
        min-width: 0;
        gap: 8px;
      }

      label span {
        gap: 8px;
        color: #2f332e;
        font-size: 0.9rem;
        font-weight: 800;
      }

      input,
      select {
        width: 100%;
        min-width: 0;
        height: 42px;
        border: 1px solid #caccc2;
        border-radius: 7px;
        background: #ffffff;
        color: #171914;
        font: inherit;
        padding: 0 12px;
      }

      input:focus,
      select:focus,
      button:focus-visible,
      a:focus-visible {
        outline: 3px solid rgba(22, 128, 91, 0.22);
        outline-offset: 2px;
      }

      .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 38px;
        border: 1px solid #cfd1c8;
        border-radius: 7px;
        cursor: pointer;
        font: inherit;
        font-weight: 850;
        line-height: 1;
        padding: 0 14px;
        white-space: nowrap;
      }

      .button.ghost {
        background: #ffffff;
        color: #20231f;
      }

      .button.dark {
        background: #171914;
        border-color: #171914;
        color: #ffffff;
      }

      .button.primary {
        background: #16805b;
        border-color: #126a4b;
        color: #ffffff;
      }

      .icon-button {
        width: 42px;
        padding: 0;
      }

      .button:hover {
        filter: brightness(0.96);
      }

      .panel-head,
      .preview-head {
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 12px;
      }

      h2,
      .plain-heading {
        display: flex;
        align-items: center;
        gap: 8px;
        margin: 0;
        font-size: 1rem;
        line-height: 1.2;
        letter-spacing: 0;
      }

      .preview-head h2 {
        font-size: 1.15rem;
      }

      .code-output {
        display: block;
        min-height: 48px;
        overflow-wrap: anywhere;
        border: 1px solid #deded7;
        border-radius: 7px;
        background: #f4f5f0;
        color: #2e332d;
        font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
        font-size: 0.86rem;
        line-height: 1.55;
        padding: 12px;
      }

      .output-stack {
        display: grid;
        gap: 10px;
      }

      .output-row {
        display: grid;
        gap: 6px;
      }

      .output-row-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
      }

      .output-label {
        color: #55584f;
        font-size: 0.78rem;
        font-weight: 850;
        letter-spacing: 0;
        text-transform: uppercase;
      }

      .copy-mini {
        min-height: 30px;
        padding: 0 10px;
        font-size: 0.82rem;
      }

      .preview-box {
        display: flex;
        position: relative;
        align-items: center;
        justify-content: center;
        min-height: 112px;
        border: 1px dashed #bfc2b7;
        border-radius: 8px;
        background: #f4f5f0;
        padding: 16px;
      }

      .preview-box img {
        max-width: 100%;
        height: auto;
      }

      .preview-box.loading img {
        opacity: 0;
      }

      .preview-box.loading::after {
        content: "Loading preview...";
        position: absolute;
        color: #55584f;
        font-size: 0.9rem;
        font-weight: 800;
      }

      .preview-box.error::after {
        content: "Preview failed.";
        color: #9f1d1d;
        font-size: 0.9rem;
        font-weight: 800;
      }

      .hint {
        margin-top: 12px;
        line-height: 1.5;
      }

      .chips {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 8px;
        margin-top: 12px;
      }

      code {
        min-width: 0;
        overflow-wrap: anywhere;
        border-radius: 6px;
        background: #eef0e9;
        color: #252923;
        font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
        font-size: 0.88rem;
        padding: 7px 8px;
      }

      .toast {
        position: fixed;
        right: 16px;
        bottom: 16px;
        border-radius: 7px;
        background: #171914;
        color: #ffffff;
        font-weight: 800;
        padding: 12px 14px;
        box-shadow: 0 12px 32px rgba(20, 20, 20, 0.2);
      }

      .hidden {
        display: none;
      }

      @media (max-width: 860px) {
        .shell {
          grid-template-columns: 1fr;
          width: min(100% - 24px, 680px);
          padding: 16px 0;
        }

        .side-column {
          position: static;
        }
      }

      @media (max-width: 560px) {
        .form-grid,
        .chips {
          grid-template-columns: 1fr;
        }

        .topbar,
        .panel-head,
        .preview-head {
          align-items: flex-start;
          flex-direction: column;
        }

        .button {
          width: 100%;
        }

        .icon-button {
          width: 42px;
        }
      }
    </style>
  </head>
  <body>
    <main class="shell">
      <section class="main-column">
        <header class="topbar">
          <div class="brand">
            <img src="https://static.cosmicpe.me/logo.svg" alt="CosmicPE" width="36" height="36" />
            <div>
              <h1>
                mcpe-shield
              </h1>
              <p>Build shields.io badges for Minecraft Bedrock servers.</p>
            </div>
          </div>
          <a class="button ghost" href="https://github.com/Cosmoverse/mcpe-shield">
            GitHub
          </a>
        </header>

        <form class="builder" data-builder>
          <div class="panel form-grid">
            <label>
              <span><Server size={16} /> Server host</span>
              <input name="host" value="cannon.cosmicpe.me" placeholder="play.example.net" autocomplete="off" />
            </label>

            <label>
              <span>Port</span>
              <input name="port" value="19132" inputmode="numeric" placeholder="19132" />
            </label>

            <label>
              <span>Colour</span>
              <select name="colour">
                <option value="">brightgreen</option>
                <option>blue</option>
                <option>green</option>
                <option>yellow</option>
                <option>orange</option>
                <option>red</option>
                <option>success</option>
                <option>informational</option>
              </select>
            </label>

            <label>
              <span>Custom hex</span>
              <input name="hex" placeholder="44cc88" autocomplete="off" />
            </label>

            <label>
              <span>Label</span>
              <input name="label" value="'motd'" autocomplete="off" />
            </label>

            <label>
              <span>Message</span>
              <input name="message" value="v'version' ('players'/'maxPlayers')" autocomplete="off" />
            </label>

            <label>
              <span>Offline label</span>
              <input name="offlineLabel" value="Server" autocomplete="off" />
            </label>

            <label>
              <span>Offline message</span>
              <input name="offlineMessage" value="offline" autocomplete="off" />
            </label>
          </div>
        </form>

        <section class="panel">
          <div class="preview-head">
            <h2><Eye size={20} /> Preview</h2>
            <button class="button primary icon-button" type="button" data-preview aria-label="Refresh preview" title="Refresh preview">
              <RefreshCw size={18} />
            </button>
          </div>
          <div class="preview-box" data-preview-box>
            <img data-preview-image alt="Badge preview" />
          </div>
          <p class="hint">URL updates as you type. Badge image only refreshes when you click Preview, because manners.</p>
        </section>
      </section>

      <aside class="side-column">
        <section class="panel">
          <h2 class="plain-heading">Placeholders</h2>
          <div class="chips">
            <code>'edition'</code>
            <code>'motd'</code>
            <code>'protocol'</code>
            <code>'version'</code>
            <code>'players'</code>
            <code>'maxPlayers'</code>
            <code>'serverId'</code>
            <code>'subMotd'</code>
            <code>'gamemode'</code>
            <code>'gamemodeId'</code>
            <code>'portIpv4'</code>
            <code>'portIpv6'</code>
          </div>
        </section>

        <section class="panel">
          <div class="panel-head">
            <h2><Sparkles size={18} /> Markdown & URLs</h2>
          </div>
          <div class="output-stack">
            <div class="output-row">
              <div class="output-row-head">
                <span class="output-label">Markdown</span>
                <button class="button dark copy-mini" type="button" data-copy-md>
                  <Clipboard size={14} /> Copy
                </button>
              </div>
              <output class="code-output" data-markdown></output>
            </div>
            <div class="output-row">
              <div class="output-row-head">
                <span class="output-label">Shields.io URL</span>
                <button class="button dark copy-mini" type="button" data-copy-shields-url>
                  <Clipboard size={14} /> Copy
                </button>
              </div>
              <output class="code-output" data-shields-url></output>
            </div>
            <div class="output-row">
              <div class="output-row-head">
                <span class="output-label">Endpoint URL</span>
                <button class="button dark copy-mini" type="button" data-copy-raw-url>
                  <Clipboard size={14} /> Copy
                </button>
              </div>
              <output class="code-output" data-raw-url></output>
            </div>
          </div>
        </section>
      </aside>
    </main>

    <div class="toast hidden" data-toast>
      Copied.
    </div>

    <script>
      const form = document.querySelector('[data-builder]') as HTMLFormElement;
      const markdownOutput = document.querySelector('[data-markdown]') as HTMLOutputElement;
      const shieldsUrlOutput = document.querySelector('[data-shields-url]') as HTMLOutputElement;
      const rawUrlOutput = document.querySelector('[data-raw-url]') as HTMLOutputElement;
      const previewBox = document.querySelector('[data-preview-box]') as HTMLDivElement;
      const previewImage = document.querySelector('[data-preview-image]') as HTMLImageElement;
      const previewButton = document.querySelector('[data-preview]') as HTMLButtonElement;
      const copyMarkdownButton = document.querySelector('[data-copy-md]') as HTMLButtonElement;
      const copyShieldsUrlButton = document.querySelector('[data-copy-shields-url]') as HTMLButtonElement;
      const copyRawUrlButton = document.querySelector('[data-copy-raw-url]') as HTMLButtonElement;
      const toast = document.querySelector('[data-toast]') as HTMLDivElement;

      const endpointBase = 'https://badge.cosmicpe.dev';
      const shieldsBase = 'https://img.shields.io/endpoint?url=';

      function cleanSegment(value: string) {
        return value.trim().replaceAll('-', ' ');
      }

      function encodeEndpointSegment(value: string) {
        return encodeURIComponent(cleanSegment(value));
      }

      function getBadgeUrls() {
        const data = new FormData(form);
        const host = cleanSegment(String(data.get('host') || 'play.example.net')) || 'play.example.net';
        const port = cleanSegment(String(data.get('port') || '19132')) || '19132';
        const colour = cleanSegment(String(data.get('hex') || data.get('colour') || ''));
        const target = `${host}:${port}`;
        const parts = [
          encodeEndpointSegment(target),
          encodeEndpointSegment(colour),
          encodeEndpointSegment(String(data.get('label') || '')),
          encodeEndpointSegment(String(data.get('message') || '')),
          encodeEndpointSegment(String(data.get('offlineLabel') || '')),
          encodeEndpointSegment(String(data.get('offlineMessage') || '')),
        ];
        while (parts.length > 1 && parts[parts.length - 1] === '') {
          parts.pop();
        }
        const rawUrl = `${endpointBase}/${parts.join('-')}`;
        const shieldsUrl = `${shieldsBase}${encodeURIComponent(rawUrl)}`;
        return { rawUrl, shieldsUrl };
      }

      function updateOutputs() {
        const { rawUrl, shieldsUrl } = getBadgeUrls();
        markdownOutput.textContent = `![Minecraft Bedrock server badge](${shieldsUrl})`;
        shieldsUrlOutput.textContent = shieldsUrl;
        rawUrlOutput.textContent = rawUrl;
      }

      function showToast() {
        toast.classList.remove('hidden');
        window.setTimeout(() => toast.classList.add('hidden'), 1800);
      }

      async function copyText(text: string) {
        await navigator.clipboard.writeText(text);
        showToast();
      }

      form.addEventListener('input', updateOutputs);
      previewButton.addEventListener('click', () => {
        previewBox.classList.remove('error');
        previewBox.classList.add('loading');
        previewImage.src = getBadgeUrls().shieldsUrl;
      });
      previewImage.addEventListener('load', () => {
        previewBox.classList.remove('loading', 'error');
      });
      previewImage.addEventListener('error', () => {
        previewBox.classList.remove('loading');
        previewBox.classList.add('error');
      });
      copyMarkdownButton.addEventListener('click', () => copyText(markdownOutput.textContent || ''));
      copyShieldsUrlButton.addEventListener('click', () => copyText(shieldsUrlOutput.textContent || ''));
      copyRawUrlButton.addEventListener('click', () => copyText(rawUrlOutput.textContent || ''));

      updateOutputs();
      previewImage.src = getBadgeUrls().shieldsUrl;
    </script>
  </body>
</html>
